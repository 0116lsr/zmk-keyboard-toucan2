#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/* 스크롤 전환 비활성화: 존재하지 않는 레이어(15)로 덮어씀 */
&trackpad_listener {
    scroller {
        layers = <15>;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        // 고속 타이핑 시 오입력을 방지하는 커스텀 mod-tap 정의
        mt_fast: behavior_mod_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_FAST";
            #binding-cells = <2>;
            flavor = "tap-preferred";      // 겹쳐 칠 때 탭(문자) 우선
            tapping-term-ms = <200>;       // 단타/홀드 기준 시간
            quick-tap-ms = <150>;          // 연타 시 홀드 무시
            require-prior-idle-ms = <150>; // 직전 키 입력 후 150ms 이내 누르면 무조건 탭
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                // 맨 윗줄: 길게 누르면 숫자(N1~N0), 짧게 누르면 문자(Q~P)
                &kp TAB   &mt_fast N1 Q &mt_fast N2 W &mt_fast N3 E &mt_fast N4 R &mt_fast N5 T   &mt_fast N6 Y &mt_fast N7 U  &mt_fast N8 I  &mt_fast N9 O   &mt_fast N0 P    &kp BSPC
                &kp LCTRL &kp A         &kp S         &kp D         &kp F         &kp G           &kp H         &kp J          &kp K          &kp L           &kp SEMI         &kp SQT
                &kp LSHFT &kp Z         &kp X         &kp C         &kp V         &kp B           &kp N         &kp M          &kp COMMA      &kp DOT         &kp FSLH         &kp ESC
                                                      &kp LGUI      &mo 1         &kp SPACE       &kp RET       &mo 2          &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB     &kp N1         &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                        &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET      &mo 2       &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans    &trans    &trans    &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans    &trans    &trans    &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans    &trans    &trans    &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
