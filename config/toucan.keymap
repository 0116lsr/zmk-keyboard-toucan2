#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&trackpad_listener {
    scroller {
        // 모든 사용 레이어에서 스크롤 작동
        layers = <0 1 2 3 4>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // 기존 ESC 3키 콤보 (TAB + Q + W)
        combo_esc_3key { timeout-ms = <150>; key-positions = <0 1 2>; bindings = <&kp ESC>; layers = <0>; };
        
        // 추가된 ESC 수직 콤보 (TAB + LCTRL)
        combo_esc_tab_ctrl { timeout-ms = <150>; key-positions = <0 12>; bindings = <&kp ESC>; layers = <0>; };

        // 숫자 수직 콤보 (BASE 레이어 한정)
        combo_num1 { timeout-ms = <85>; key-positions = <1 13>; bindings = <&kp N1>; layers = <0>; };
        combo_num2 { timeout-ms = <85>; key-positions = <2 14>; bindings = <&kp N2>; layers = <0>; };
        combo_num3 { timeout-ms = <85>; key-positions = <3 15>; bindings = <&kp N3>; layers = <0>; };
        combo_num4 { timeout-ms = <85>; key-positions = <4 16>; bindings = <&kp N4>; layers = <0>; };
        combo_num5 { timeout-ms = <85>; key-positions = <5 17>; bindings = <&kp N5>; layers = <0>; };

        combo_num6 { timeout-ms = <85>; key-positions = <6 18>; bindings = <&kp N6>; layers = <0>; };
        combo_num7 { timeout-ms = <85>; key-positions = <7 19>; bindings = <&kp N7>; layers = <0>; };
        combo_num8 { timeout-ms = <85>; key-positions = <8 20>; bindings = <&kp N8>; layers = <0>; };
        combo_num9 { timeout-ms = <85>; key-positions = <9 21>; bindings = <&kp N9>; layers = <0>; };
        combo_num0 { timeout-ms = <85>; key-positions = <10 22>; bindings = <&kp N0>; layers = <0>; };

        // 방향키 콤보 (M 기준, BASE 레이어 한정)
        combo_up    { timeout-ms = <85>;  key-positions = <19 31>;    bindings = <&kp UP>;    layers = <0>; };
        combo_left  { timeout-ms = <85>;  key-positions = <30 31>;    bindings = <&kp LEFT>;  layers = <0>; };
        combo_right { timeout-ms = <85>;  key-positions = <31 32>;    bindings = <&kp RIGHT>; layers = <0>; };
        combo_down  { timeout-ms = <150>; key-positions = <30 31 32>; bindings = <&kp DOWN>;  layers = <0>; }; // N + M + COMMA (3키)

        // 두음법 특수문자 3키 콤보 (BASE 레이어 한정)
        combo_lbkt  { timeout-ms = <150>; key-positions = <1 2 3>;    bindings = <&kp LBKT>;  layers = <0>; }; // Q + W + E = [
        combo_rbkt  { timeout-ms = <150>; key-positions = <2 3 4>;    bindings = <&kp RBKT>;  layers = <0>; }; // W + E + R = ]
        combo_tilde { timeout-ms = <150>; key-positions = <13 14 15>; bindings = <&kp TILDE>; layers = <0>; }; // A + S + D = ~
        combo_excl  { timeout-ms = <150>; key-positions = <14 15 16>; bindings = <&kp EXCL>;  layers = <0>; }; // S + D + F = !
        combo_bslh  { timeout-ms = <150>; key-positions = <15 16 17>; bindings = <&kp BSLH>;  layers = <0>; }; // D + F + G = 백슬래시

        // 괄호 3키 콤보 (BASE 레이어 한정)
        combo_lpar  { timeout-ms = <150>; key-positions = <25 26 27>; bindings = <&kp LPAR>;  layers = <0>; }; // Z + X + C = (
        combo_rpar  { timeout-ms = <150>; key-positions = <26 27 28>; bindings = <&kp RPAR>;  layers = <0>; }; // X + C + V = )
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        // ZMK Studio에서 사용하기 위해 복구된 커스텀 Mod-Tap
        mt_fast: behavior_mod_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_FAST";
            #binding-cells = <2>;
            flavor = "tap-preferred";      
            tapping-term-ms = <400>;       
            quick-tap-ms = <200>;          
            require-prior-idle-ms = <200>; 
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                &kp LGUI &mo 1 &kp SPACE  &kp RET &mo 2 &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB     &kp N1         &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                        &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET      &mo 2       &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans    &trans    &trans    &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans    &trans    &trans    &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans    &trans    &trans    &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
